  "instructions_to_main_agent": [
    "Install Oswald and Manrope fonts via Google Fonts in index.html or CSS.",
    "Configure Tailwind theme colors to match the brand identity exactly.",
    "Use 'rounded-none' for a sharp, industrial, precision look for all buttons and cards.",
    "Implement the 'Split Hero' layout: Image on right (50%), Bold Text on left (50%) with Teal CTA.",
    "Use Shadcn components but OVERRIDE the default rounded-md to rounded-none.",
    "Ensure the 'Wigzo Tape' logo is prominent in the header.",
    "For the Admin Panel, keep it clean and functional with a sidebar layout.",
    "Integrate Razorpay dummy flow for checkout if actual keys are not provided.",
    "Use the provided image URLs as placeholders where real product images are missing.",
    "Add 'data-testid' to all interactive elements."
  ],
  "universal_guidelines": [
    "Do not use gradients for backgrounds, stick to solid white or very light teal.",
    "Ensure high contrast for text (Black on White, White on Teal).",
    "Micro-interactions on buttons: Scale up slightly (1.05) on hover.",
    "Use skeleton loaders for product fetching states."
  ]
